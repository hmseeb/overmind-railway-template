{
	admin off
	auto_https off
	servers {
		# Only Railway's edge reaches this port; keep its X-Forwarded-Proto https.
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

:{$PORT:8080} {
	encode gzip

	# Guest sessions create throwaway accounts for anyone; off on a public deployment.
	@guest path /api/auth/guest /api/auth/guest/*
	respond @guest `{"detail":"Guest sessions are disabled on this deployment."}` 403

	# Everything Django and the MCP/OAuth server answer (overbae/urls.py, services/mcp/oauth_routes.py).
	@backend path /api/* /v1/* /health /robots.txt /.well-known/* /register /authorize /token /revoke /{$DJANGO_ADMIN_PATH:admin} /{$DJANGO_ADMIN_PATH:admin}/*
	handle @backend {
		reverse_proxy 127.0.0.1:8001 {
			flush_interval -1
		}
	}

	handle_path /static/* {
		root * /code/static
		file_server
	}

	handle {
		root * /srv/console
		try_files {path} /index.html
		file_server
	}
}
